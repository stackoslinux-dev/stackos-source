def run(cmd, check=True):
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True)
    if check and r.returncode != 0:
        return None
    return r

class StackOSInstaller(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='com.stackos.installer')
        self.connect('activate', self.on_activate)
        self.disk = ""
        self.mode = ""
        self.username = ""
        self.password = ""
        self.hostname = ""
        self.locale = "pt_BR.UTF-8"
        self.timezone = "America/Sao_Paulo"
        self.efi = ""
        self.root = ""

    def on_activate(self, app):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        self.win = Gtk.ApplicationWindow(application=app)
        self.win.set_title("Instalador StackOS Genesis")
        self.win.set_default_size(700, 540)
        self.win.set_resizable(False)
        self.win.connect('close-request', self.on_close)
        self.show_welcome()
        self.win.present()

    def on_close(self, win):
        dialog = Gtk.AlertDialog()
        dialog.set_message("Cancelar instalacao?")
        dialog.set_detail("Tem certeza que deseja sair do instalador?")
        dialog.set_buttons(["Continuar", "Sair"])
        dialog.set_default_button(0)
        dialog.set_cancel_button(0)
        dialog.choose(self.win, None, self.on_close_response)
        return True

    def on_close_response(self, dialog, result):
        btn = dialog.choose_finish(result)
        if btn == 1:
            self.quit()

    def clear(self):
        child = self.win.get_child()
        if child:
            self.win.set_child(None)

    def make_header(self, subtitle=""):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_margin_bottom(20)
        title = Gtk.Label(label="Instalador StackOS Genesis")
        title.add_css_class('title')
        box.append(title)
        if subtitle:
            sub = Gtk.Label(label=subtitle)
            sub.add_css_class('subtitle')
            box.append(sub)
        sep = Gtk.Separator()
        sep.add_css_class('separator')
        sep.set_margin_top(10)
        box.append(sep)
        return box

