    def do_install(self):
        disk = self.disk

        if self.mode == 'erase':
            self.set_status("Particionando o disco...")
            if "nvme" in disk:
                self.efi = disk + "p1"
                self.root = disk + "p2"
            else:
                self.efi = disk + "1"
                self.root = disk + "2"
            run("wipefs -af " + disk)
            run("sgdisk --zap-all " + disk)
            run("sgdisk -n 1:0:+300M -t 1:ef00 " + disk)
            run("sgdisk -n 2:0:0 -t 2:8300 " + disk)
            run("partprobe " + disk)
            time.sleep(2)
            run("mkfs.fat -F32 " + self.efi)
            run("mkfs.ext4 -F " + self.root)

        elif self.mode == 'dual':
            self.set_status("Criando particoes para dual boot...")
            efi_start = self.dual_start
            efi_end = self.dual_start + 300
            root_start = efi_end
            root_end = root_start + self.dual_size
            run(f"parted -s -a optimal {disk} mkpart primary fat32 {efi_start}MiB {efi_end}MiB")
            run(f"parted -s -a optimal {disk} mkpart primary ext4 {root_start}MiB {root_end}MiB")
            run(f"partprobe {disk}")
            time.sleep(2)
            lsblk2 = subprocess.run(['lsblk','-rno','NAME,FSTYPE,MOUNTPOINT'], capture_output=True, text=True)
            disk_base = disk.replace('/dev/','')
            new_parts = []
            for line in lsblk2.stdout.splitlines():
                parts = line.strip().split()
                name = parts[0] if parts else ''
                fstype = parts[1] if len(parts) > 1 else ''
                mountpoint = parts[2] if len(parts) > 2 else ''
                if disk_base in name and name != disk_base and fstype in ['','vfat','ext4'] and mountpoint == '':
                    new_parts.append(f'/dev/{name}')
            self.efi = new_parts[-2]
            self.root = new_parts[-1]
            run(f"mkfs.fat -F32 {self.efi}")
            run(f"mkfs.ext4 -F {self.root}")

        self.set_status("Montando particoes...")
        run("mkdir -p /mnt/stackos-install")
        run("mount " + self.root + " /mnt/stackos-install")
        run("mkdir -p /mnt/stackos-install/boot/efi")
        run("mount " + self.efi + " /mnt/stackos-install/boot/efi")

        self.set_status("Copiando sistema... pode demorar varios minutos.")
        run("unsquashfs -f -d /mnt/stackos-install /cdrom/casper/filesystem.squashfs")

        self.set_status("Copiando kernel...")
        run("cp -a /cdrom/casper/vmlinuz /mnt/stackos-install/boot/")
        run("cp -a /cdrom/casper/initrd.img /mnt/stackos-install/boot/")

        self.set_status("Configurando usuario e sistema...")
        run("chroot /mnt/stackos-install userdel -r stackos", check=False)
        run("chroot /mnt/stackos-install useradd -m -s /bin/bash -G sudo,adm,cdrom,dip,plugdev " + self.username)
        if self.password:
            subprocess.run("chroot /mnt/stackos-install chpasswd", input=self.username+":"+self.password+"\n", shell=True, capture_output=True, text=True)
        else:
            run("chroot /mnt/stackos-install passwd -d " + self.username, check=False)
        with open("/mnt/stackos-install/etc/hostname", "w") as f:
            f.write(self.hostname + "\n")
        with open("/mnt/stackos-install/etc/hosts", "w") as f:
            f.write("127.0.0.1 localhost\n127.0.1.1 " + self.hostname + "\n")
        run("chroot /mnt/stackos-install ln -sf /usr/share/zoneinfo/" + self.timezone + " /etc/localtime", check=False)
        with open("/mnt/stackos-install/etc/locale.gen", "a") as f:
            f.write(self.locale + " UTF-8\n")
        run("chroot /mnt/stackos-install locale-gen", check=False)
        with open("/mnt/stackos-install/etc/default/locale", "w") as f:
            f.write("LANG=" + self.locale + "\n")
        with open("/mnt/stackos-install/etc/gdm3/custom.conf", "w") as f:
            f.write("[daemon]\nAutomaticLoginEnable=true\nAutomaticLogin=" + self.username + "\n[security]\nAllowRoot=false\n")
        import os
        os.makedirs("/mnt/stackos-install/etc/polkit-1/rules.d", exist_ok=True)
        with open("/mnt/stackos-install/etc/polkit-1/rules.d/10-stackos.rules", "w") as f:
            f.write("polkit.addRule(function(action, subject) {\n    if (subject.isInGroup(\"sudo\")) {\n        return polkit.Result.YES;\n    }\n});\n")

        self.set_status("Configurando fstab...")
        root_uuid = run("blkid -s UUID -o value " + self.root).stdout.strip()
        efi_uuid = run("blkid -s UUID -o value " + self.efi).stdout.strip()
        fstab = "UUID=" + root_uuid + " / ext4 errors=remount-ro 0 1\n"
        fstab += "UUID=" + efi_uuid + " /boot/efi vfat umask=0077 0 1\n"
        with open("/mnt/stackos-install/etc/fstab", "w") as f:
            f.write(fstab)

        self.set_status("Instalando bootloader GRUB...")
        run("mount --bind /dev /mnt/stackos-install/dev")
        run("mount --bind /proc /mnt/stackos-install/proc")
        run("mount --bind /sys /mnt/stackos-install/sys")
        run("mount --bind /sys/firmware/efi/efivars /mnt/stackos-install/sys/firmware/efi/efivars", check=False)
        run("chroot /mnt/stackos-install grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=StackOS  " + disk)
        run("chroot /mnt/stackos-install grub-mkconfig -o /boot/grub/grub.cfg")
        grub_cfg = "set default=0\nset timeout=5\n\nmenuentry 'StackOS Genesis' {\n    search --no-floppy --fs-uuid --set=root " + root_uuid + "\n    linux /boot/vmlinuz root=UUID=" + root_uuid + " quiet\n    initrd /boot/initrd.img\n}\n"
        with open("/mnt/stackos-install/boot/grub/grub.cfg", "w") as f:
            f.write(grub_cfg)
        run("rm -f /mnt/stackos-install/etc/xdg/autostart/stackos-installer.desktop", check=False)
        run("rm -f /mnt/stackos-install/usr/share/applications/stackos-installer.desktop", check=False)
        subprocess.run("rm -f /mnt/stackos-install/etc/apt/sources.list.d/stackos-local.list", shell=True)
        with open("/mnt/stackos-install/etc/apt/sources.list.d/ubuntu.list", "w") as f:
            f.write("""deb http://archive.ubuntu.com/ubuntu resolute main restricted universe multiverse
deb http://archive.ubuntu.com/ubuntu resolute-updates main restricted universe multiverse
deb http://archive.ubuntu.com/ubuntu resolute-security main restricted universe multiverse
""")
        with open("/mnt/stackos-install/etc/apt/sources.list.d/stackos.list", "w") as f:
            f.write("deb [trusted=yes] https://stackoslinux-dev.github.io/repo/base genesis main\n")
            f.write("deb [trusted=yes] https://stackoslinux-dev.github.io/repo/branding genesis main\n")
            f.write("deb [trusted=yes] https://stackoslinux-dev.github.io/repo/apps genesis main\n")
            f.write("deb [trusted=yes] https://stackoslinux-dev.github.io/repo/drivers genesis main\n")
            f.write("deb [trusted=yes] https://stackoslinux-dev.github.io/repo/installer genesis main\n")
        with open("/mnt/stackos-install/etc/dconf/db/local.d/01-stackos-dock", "w") as f:
            f.write("[org/gnome/desktop/interface]\ngtk-theme='Orchis-Purple-Dark'\nicon-theme='Yaru-blue'\n\n[org/gnome/shell]\nfavorite-apps=['org.gnome.Nautilus.desktop', 'firefox.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Settings.desktop', 'stackos-store.desktop', 'stackos-drivers.desktop', 'stackos-bugreport.desktop']\n\n[org/gnome/shell/extensions/dash-to-dock]\ndash-max-icon-size=60\n")
        run("chroot /mnt/stackos-install dconf update", check=False)
        import os
        os.makedirs("/mnt/stackos-install/etc/NetworkManager", exist_ok=True)
        with open("/mnt/stackos-install/etc/NetworkManager/NetworkManager.conf", "w") as f:
            f.write("[main]\nplugins=ifupdown,keyfile\n[ifupdown]\nmanaged=true\n")
        with open("/mnt/stackos-install/etc/sudoers.d/stackos-user", "w") as f:
            f.write("%sudo ALL=(ALL) NOPASSWD: ALL\n")
        import os
        os.chmod("/mnt/stackos-install/etc/sudoers.d/stackos-user", 0o440)

        self.set_status("Finalizando...")
        run("umount -lf /mnt/stackos-install/sys/firmware/efi/efivars", check=False)
        run("umount -lf /mnt/stackos-install/dev", check=False)
        run("umount -lf /mnt/stackos-install/proc", check=False)
        run("umount -lf /mnt/stackos-install/sys", check=False)
        run("umount -lf /mnt/stackos-install/boot/efi", check=False)
        run("umount -lf /mnt/stackos-install", check=False)

        GLib.idle_add(self.show_done)

    def show_done(self):
        self.clear()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_margin_top(60)
        box.set_margin_bottom(40)
        box.set_margin_start(60)
        box.set_margin_end(60)

        title = Gtk.Label(label="Instalacao Concluida")
        title.add_css_class('title')
        title.set_margin_bottom(8)
        box.append(title)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.add_css_class('card')
        card.set_margin_top(20)
        card.set_margin_bottom(30)

        msg = Gtk.Label(label="O StackOS Genesis foi instalado com sucesso.\n\nRemova o pendrive e reinicie o computador\npara iniciar o sistema instalado.")
        msg.add_css_class('label-white')
        msg.set_justify(Gtk.Justification.CENTER)
        msg.set_wrap(True)
        card.append(msg)
        box.append(card)

        btn = Gtk.Button(label="Reiniciar agora")
        btn.add_css_class('btn-primary')
        btn.set_halign(Gtk.Align.CENTER)
        btn.connect('clicked', lambda b: run("reboot", check=False))
        box.append(btn)

        self.win.set_child(box)

app = StackOSInstaller()
