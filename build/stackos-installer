    def show_disk(self):
        self.clear()
        r = subprocess.run(['lsblk','-rno','NAME,TYPE,SIZE,RM'], capture_output=True, text=True)
        disks = []
        for line in r.stdout.splitlines():
            p = line.split()
            if len(p) >= 4 and p[1] == 'disk' and p[3] == '0':
                disks.append((p[0], p[2]))

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_margin_top(30)
        box.set_margin_bottom(30)
        box.set_margin_start(60)
        box.set_margin_end(60)
        box.append(self.make_header("Selecione o disco de instalacao"))

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.add_css_class('card')
        card.set_margin_bottom(20)

        self.disk_radios = []
        group = None
        for name, size in disks:
            rb = Gtk.CheckButton(label=f"/dev/{name}  —  {size}")
            rb.add_css_class('radio')
            if group is None:
                group = rb
            else:
                rb.set_group(group)
            rb.disk = f"/dev/{name}"
            self.disk_radios.append(rb)
            card.append(rb)

        if self.disk_radios:
            self.disk_radios[0].set_active(True)

        box.append(card)
        nav, btn = self.make_nav(
            back_cb=lambda b: self.show_welcome(),
            next_label="Proximo",
            next_cb=lambda b: self.on_disk_next()
        )
        box.append(nav)
        self.win.set_child(box)

    def on_disk_next(self):
        for rb in self.disk_radios:
            if rb.get_active():
                self.disk = rb.disk
                break
        if not self.disk:
            return
        self.show_mode()

