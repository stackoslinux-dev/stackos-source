class StackOSDrivers(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='com.stackos.drivers')
        self.connect('activate', self.on_activate)
        self.needs_reboot = False

    def on_activate(self, app):
        p = Gtk.CssProvider(); p.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.win = Gtk.ApplicationWindow(application=app)
        self.win.set_title("StackOS Drivers")
        self.win.set_default_size(820, 600)
        self._build_ui()
        self.win.present()

    def _build_ui(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        # Header
        hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        hdr.add_css_class('header')
        ic = Gtk.Image.new_from_icon_name('preferences-system-symbolic')
        ic.set_pixel_size(36); hdr.append(ic)
        tb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        tr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        for txt, cls in [('Stack','title'),('OS','title-accent'),(' Drivers','title')]:
            l = Gtk.Label(label=txt); l.add_css_class(cls); tr.append(l)
        tb.append(tr)
        sub = Gtk.Label(label='GERENCIADOR DE DRIVERS')
        sub.add_css_class('subtitle'); sub.set_halign(Gtk.Align.START); tb.append(sub)
        hdr.append(tb)
        sp2 = Gtk.Box(); sp2.set_hexpand(True); hdr.append(sp2)
        # Info kernel + driver ativo
        sys_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        sys_box.set_halign(Gtk.Align.END)
        kl = Gtk.Label(label=f'Kernel: {get_kernel_version()}')
        kl.add_css_class('label-gray'); sys_box.append(kl)
        active = get_active_gpu_driver() or get_gpu_info()
        if active:
            al = Gtk.Label(label=f'Driver ativo: {active[:40]}')
            al.add_css_class('label-green'); sys_box.append(al)
        hdr.append(sys_box)
        sp = Gtk.Box(); sp.set_hexpand(True); hdr.append(sp)
        scan_btn = Gtk.Button(label='↻  Verificar Hardware')
        scan_btn.add_css_class('btn-scan')
        scan_btn.connect('clicked', lambda _: self.scan())
        hdr.append(scan_btn)
        root.append(hdr)

        # Status + progress
        self.status_lbl = Gtk.Label(label='Detectando hardware...')
        self.status_lbl.add_css_class('status-info')
        self.status_lbl.set_halign(Gtk.Align.START)
        self.status_lbl.set_margin_start(20); self.status_lbl.set_margin_top(8)
        self.status_lbl.set_margin_bottom(4); root.append(self.status_lbl)
        self.progress = Gtk.ProgressBar()
        self.progress.add_css_class('progress')
        self.progress.set_margin_start(20); self.progress.set_margin_end(20)
        self.progress.set_margin_bottom(8); self.progress.set_visible(False)
        root.append(self.progress)

        # Scroll + conteúdo
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_vexpand(True)
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.content.set_margin_top(10); self.content.set_margin_start(20)
        self.content.set_margin_end(20); self.content.set_margin_bottom(20)
        self.scroll.set_child(self.content)
        root.append(self.scroll)

        # Status bar
        self.status_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.status_bar.add_css_class('status-bar')
        self.status_bar_lbl = Gtk.Label(label='')
        self.status_bar_lbl.add_css_class('status-text')
        self.status_bar_lbl.set_halign(Gtk.Align.START)
        self.status_bar.append(self.status_bar_lbl)
        root.append(self.status_bar)

        self.win.set_child(root)
        self.scan()

    def _clear(self):
        while c := self.content.get_first_child():
            self.content.remove(c)

    def _status(self, txt, kind='info'):
        self.status_lbl.set_text(txt)
        for c in ('status-info','status-ok','status-err','status-warn','status-text'):
            self.status_lbl.remove_css_class(c)
        self.status_lbl.add_css_class(f'status-{kind}')

    def _bar(self, txt):
        self.status_bar_lbl.set_text(txt)

    # ── Scan ─────────────────────────────────────────────────
    def scan(self):
        self._clear()
        self._status('Detectando hardware...', 'info')
        self.progress.set_visible(True)
        def do():
            GLib.idle_add(self.progress.pulse)
            devices = detect_hardware()
            ud = run("ubuntu-drivers devices 2>/dev/null").stdout
            GLib.idle_add(self._show_results, devices, ud)
        threading.Thread(target=do, daemon=True).start()

    def _show_results(self, devices, ubuntu_out):
        self._clear()
        self.progress.set_visible(False)

        # Banner de reinicialização pendente
        if self.needs_reboot:
            rb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            rb.add_css_class('reboot-banner'); rb.set_margin_bottom(4)
            ri = Gtk.Image.new_from_icon_name('system-restart-symbolic')
            ri.set_pixel_size(24); rb.append(ri)
            rl = Gtk.Label(label='⚠  Driver instalado. Reinicie o sistema para aplicar as mudanças.')
            rl.add_css_class('status-warn'); rl.set_halign(Gtk.Align.START)
            rl.set_hexpand(True); rb.append(rl)
            self.content.append(rb)

        if not devices:
            e = Gtk.Label(label='Nenhum dispositivo detectado.')
            e.add_css_class('label-gray'); e.set_margin_top(60)
            e.set_halign(Gtk.Align.CENTER); self.content.append(e)
            self._status('Nenhum dispositivo encontrado.', 'warn'); return

        count = 0
        for dev in devices:
            drivers = get_drivers(dev)
            if not drivers: continue
            self.content.append(self._mk_hw_card(dev, drivers))
            count += 1

        installed_total = sum(1 for dev in devices
                              for d in get_drivers(dev) if is_driver_present(d['pkg']))
        self._status(f'✓  {len(devices)} dispositivo(s) detectado(s) — {installed_total} driver(s) instalado(s)', 'ok')
        self._bar(f'Hardware: {len(devices)} dispositivos | Use pkexec para instalar drivers')

    # ── Card de hardware ──────────────────────────────────────
    def _mk_hw_card(self, dev, drivers):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.add_css_class('hw-card')

        # Cabeçalho do card
        hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        hdr.set_margin_top(14); hdr.set_margin_start(16)
        hdr.set_margin_end(16); hdr.set_margin_bottom(10)

        ic = Gtk.Image.new_from_icon_name(dev.get('icon','preferences-system-symbolic'))
        ic.set_pixel_size(32); hdr.append(ic)

        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        info.set_hexpand(True)
        name = Gtk.Label(label=dev['name'][:80])
        name.add_css_class('label-white'); name.set_halign(Gtk.Align.START)
        info.append(name)
        sub = Gtk.Label(label=f"{dev['type']}  ·  {dev['vendor']}")
        sub.add_css_class('label-gray'); sub.set_halign(Gtk.Align.START)
        info.append(sub)
        hdr.append(info)
        card.append(hdr)

        sep = Gtk.Separator(); card.append(sep)

        # Lista de drivers
        drv_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        drv_box.set_margin_top(10); drv_box.set_margin_start(14)
        drv_box.set_margin_end(14); drv_box.set_margin_bottom(14)
        for d in drivers:
            drv_box.append(self._mk_driver_row(d))
        card.append(drv_box)
        return card

    # ── Linha de driver ───────────────────────────────────────
    def _mk_driver_row(self, drv):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.add_css_class('drv-row')

        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        info.set_hexpand(True)

        # Nome + badges
        nb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        nl = Gtk.Label(label=drv['name'])
        nl.add_css_class('label-white'); nl.set_halign(Gtk.Align.START); nb.append(nl)

        tag = drv.get('tag','')
        if tag == 'rec':
            b = Gtk.Label(label='RECOMENDADO'); b.add_css_class('badge-rec'); nb.append(b)
        elif tag == 'ok':
            b = Gtk.Label(label='TESTADO'); b.add_css_class('badge-ok'); nb.append(b)
        elif tag == 'free':
            b = Gtk.Label(label='LIVRE'); b.add_css_class('badge-free'); nb.append(b)
        if drv.get('type') == 'prop':
            b2 = Gtk.Label(label='PROPRIETÁRIO'); b2.add_css_class('badge-prop'); nb.append(b2)
        info.append(nb)

        # Desc + versão instalada
        desc_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        dl = Gtk.Label(label=drv.get('desc','')[:80])
        dl.add_css_class('label-gray'); dl.set_halign(Gtk.Align.START)
        dl.set_wrap(True); desc_row.append(dl)
        ver = get_pkg_version(drv['pkg'])
        if ver:
            vl = Gtk.Label(label=f'v{ver}')
            vl.add_css_class('label-green'); desc_row.append(vl)
        info.append(desc_row)

        # Pacote
        pl = Gtk.Label(label=drv['pkg'])
        pl.add_css_class('label-gray'); pl.set_halign(Gtk.Align.START)
        info.append(pl)

        row.append(info)

        installed = is_driver_present(drv['pkg'])
        ver = get_driver_version(drv['pkg'])
        btn_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        btn_box.set_halign(Gtk.Align.END); btn_box.set_valign(Gtk.Align.CENTER)
        if installed:
            inst_btn = Gtk.Button(label='✓ Instalado')
            inst_btn.add_css_class('btn-installed'); inst_btn.set_sensitive(False)
            btn_box.append(inst_btn)
            if ver:
                vl = Gtk.Label(label=f'versão {ver}')
                vl.add_css_class('label-green'); vl.set_halign(Gtk.Align.CENTER)
                btn_box.append(vl)
            rem_btn = Gtk.Button(label='Remover')
            rem_btn.add_css_class('btn-remove')
            rem_btn.connect('clicked', lambda _, p=drv['pkg']: self._remove(p))
            btn_box.append(rem_btn)
        else:
            btn = Gtk.Button(label='Instalar')
            btn.add_css_class('btn-install')
            btn.connect('clicked', lambda _, p=drv['pkg']: self._install(p))
            btn_box.append(btn)
        row.append(btn_box)
        return row

    # ── Instalar driver ───────────────────────────────────────
    def _install(self, pkg):
        self._status(f'Instalando {pkg}...', 'info')
        self.progress.set_visible(True)
        def do():
            GLib.idle_add(self.progress.pulse)
            r = run(f"pkexec apt-get install -y {pkg} 2>&1")
            ok = r.returncode == 0
            if ok:
                self.needs_reboot = True
                GLib.idle_add(self._status, f'✓ {pkg} instalado! Reinicie para aplicar.', 'ok')
            else:
                GLib.idle_add(self._status, f'✗ Falha ao instalar {pkg}.', 'err')
            GLib.idle_add(self.progress.set_visible, False)
            GLib.idle_add(self.scan)
        threading.Thread(target=do, daemon=True).start()

    # ── Remover driver ────────────────────────────────────────
    def _remove(self, pkg):
        self._status(f'Removendo {pkg}...', 'warn')
        self.progress.set_visible(True)
        def do():
            GLib.idle_add(self.progress.pulse)
            r = run(f"pkexec apt-get remove -y {pkg} 2>&1")
            ok = r.returncode == 0
            if ok:
                self.needs_reboot = True
                GLib.idle_add(self._status, f'✓ {pkg} removido! Reinicie para aplicar.', 'ok')
            else:
                GLib.idle_add(self._status, f'✗ Falha ao remover {pkg}.', 'err')
            GLib.idle_add(self.progress.set_visible, False)
            GLib.idle_add(self.scan)
        threading.Thread(target=do, daemon=True).start()

