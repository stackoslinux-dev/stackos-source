def run(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True)

def is_installed(pkg):
    return bool(run(f"dpkg -l {pkg} 2>/dev/null | grep '^ii'").stdout.strip())

def get_pkg_version(pkg):
    r = run(f"dpkg -l {pkg} 2>/dev/null | grep '^ii'")
    if r.stdout.strip():
        p = r.stdout.strip().split()
        return p[2] if len(p) >= 3 else ''
    return ''

ALT_PKGS = {
    'xserver-xorg-video-amdgpu': ['xserver-xorg-video-amdgpu', 'libdrm-amdgpu1', 'mesa-utils'],
    'xserver-xorg-video-intel':  ['xserver-xorg-video-intel',  'libdrm-intel1',   'mesa-utils'],
    'xserver-xorg-video-radeon': ['xserver-xorg-video-radeon', 'libdrm-radeon1'],
    'firmware-amd-graphics':     ['firmware-amd-graphics', 'linux-firmware'],
    'firmware-iwlwifi':          ['firmware-iwlwifi', 'linux-firmware'],
    'firmware-realtek':          ['firmware-realtek', 'linux-firmware'],
    'firmware-atheros':          ['firmware-atheros', 'linux-firmware'],
    'linux-firmware':            ['linux-firmware'],
    'intel-microcode':           ['intel-microcode'],
    'alsa-firmware-loaders':     ['alsa-firmware-loaders', 'alsa-utils'],
    'pulseaudio':                ['pulseaudio', 'pipewire-pulse'],
    'bluez':                     ['bluez'],
}

KMOD_MAP = {
    'xserver-xorg-video-amdgpu': 'amdgpu',
    'xserver-xorg-video-radeon': 'radeon',
    'xserver-xorg-video-nouveau':'nouveau',
    'xserver-xorg-video-intel':  'i915',
}

def is_driver_present(pkg):
    if is_installed(pkg): return True
    kmod = KMOD_MAP.get(pkg)
    if kmod:
        if run(f"lsmod 2>/dev/null | grep '^{kmod} '").stdout.strip(): return True
    for alt in ALT_PKGS.get(pkg, []):
        if is_installed(alt): return True
    return False

def get_driver_version(pkg):
    ver = get_pkg_version(pkg)
    if ver: return ver
    kmod = KMOD_MAP.get(pkg)
    if kmod:
        r = run(f"modinfo {kmod} 2>/dev/null | grep '^version:'")
        if r.stdout.strip():
            return r.stdout.strip().split()[-1]
    for alt in ALT_PKGS.get(pkg, []):
        ver = get_pkg_version(alt)
        if ver: return f'{ver}'
    return ''

def get_active_gpu_driver():
    """Detecta o driver de GPU ativo no momento."""
    # Tenta glxinfo
    r = run("glxinfo 2>/dev/null | grep 'OpenGL renderer'")
    if r.stdout.strip():
        return r.stdout.strip().split(':', 1)[-1].strip()
    # Tenta lsmod
    for mod in ['amdgpu', 'nvidia', 'i915', 'radeon', 'nouveau']:
        r = run(f"lsmod 2>/dev/null | grep '^{mod}'")
        if r.stdout.strip():
            return mod
    return ''

def get_kernel_version():
    r = run("uname -r")
    return r.stdout.strip()

def get_gpu_info():
    """Info extra da GPU via lspci -v."""
    r = run("lspci -v 2>/dev/null | grep -A3 -iE 'vga|3d|display' | grep -i 'kernel driver'")
    if r.stdout.strip():
        return r.stdout.strip().split(':', 1)[-1].strip()
    return ''

def detect_hardware():
    devices = []

    # GPU — usa lspci -mm para output estruturado mais confiável
    gpu = run("lspci -mm | grep -iE 'vga|3d|display'")
    # Também tenta via lspci normal
    gpu2 = run("lspci | grep -iE 'vga|3d|display'")
    seen = set()
    for line in gpu2.stdout.splitlines():
        up = line.upper()
        # NVIDIA deve vir ANTES de AMD porque algumas placas híbridas
        # têm "AMD" no nome mas o chip principal é NVIDIA
        if 'NVIDIA' in up or 'GEFORCE' in up or 'QUADRO' in up or 'RTX' in up or 'GTX' in up:
            vendor = 'NVIDIA'
        elif 'INTEL' in up and ('IRIS' in up or 'UHD' in up or 'HD GRAPHICS' in up or
                                 'RPL' in up or 'ARC' in up or 'RAPTOR' in up or 'ALDER' in up):
            vendor = 'Intel'
        elif 'INTEL' in up:
            vendor = 'Intel'
        elif 'AMD' in up or 'ATI' in up or 'RADEON' in up:
            vendor = 'AMD'
        else:
            vendor = 'Generic'
        name = line.split(':', 2)[-1].strip()
        key = f"{vendor}:{name[:40]}"
        if key not in seen:
            seen.add(key)
            devices.append({
                'type': 'GPU', 'vendor': vendor,
                'name': name,
                'icon': 'video-display-symbolic'
            })

    # WiFi / Rede
    wifi = run("lspci | grep -iE 'wireless|wifi|802.11|network'")
    for line in wifi.stdout.splitlines():
        up = line.upper()
        if 'BROADCOM' in up or 'BCM' in up:
            vendor = 'Broadcom'
        elif 'REALTEK' in up:
            vendor = 'Realtek'
        elif 'INTEL' in up:
            vendor = 'Intel'
        elif 'ATHEROS' in up or 'QUALCOMM' in up:
            vendor = 'Atheros'
        elif 'MEDIATEK' in up or 'MT' in up:
            vendor = 'MediaTek'
        else:
            vendor = 'Generic'
        devices.append({
            'type': 'WiFi', 'vendor': vendor,
            'name': line.split(':', 2)[-1].strip(),
            'icon': 'network-wireless-symbolic'
        })

    # Bluetooth
    bt = run("lsusb | grep -i bluetooth")
    for line in bt.stdout.splitlines():
        devices.append({
            'type': 'Bluetooth', 'vendor': 'USB',
            'name': line.split(':', 1)[-1].strip(),
            'icon': 'bluetooth-symbolic'
        })

    # Áudio
    audio = run("lspci | grep -iE 'audio|sound|multimedia'")
    for line in audio.stdout.splitlines():
        up = line.upper()
        vendor = 'Intel' if 'INTEL' in up else ('AMD' if 'AMD' in up else 'Generic')
        devices.append({
            'type': 'Áudio', 'vendor': vendor,
            'name': line.split(':', 2)[-1].strip(),
            'icon': 'audio-card-symbolic'
        })

    return devices

def get_drivers(device):
    drivers = []
    vendor = device['vendor']
    dtype  = device['type']

    if vendor == 'NVIDIA':
        r = run("apt-cache search nvidia-driver 2>/dev/null | grep '^nvidia-driver-[0-9]' | sort -t'-' -k3 -rn | head -5")
        versions = []
        for line in r.stdout.splitlines():
            if ' - ' in line:
                pkg = line.split(' - ')[0].strip()
                versions.append(pkg)
        for i, pkg in enumerate(versions):
            ver = pkg.replace('nvidia-driver-', '')
            drivers.append({
                'pkg': pkg, 'name': f'NVIDIA Driver {ver}',
                'desc': f'Driver proprietário NVIDIA versão {ver}.',
                'tag': 'rec' if i == 0 else 'ok', 'type': 'prop'
            })
        drivers.append({
            'pkg': 'xserver-xorg-video-nouveau', 'name': 'Nouveau',
            'desc': 'Driver open source para NVIDIA. Menor desempenho.',
            'tag': 'free', 'type': 'free'
        })

    elif vendor == 'AMD':
        drivers += [
            {'pkg': 'xserver-xorg-video-amdgpu', 'name': 'AMDGPU',
             'desc': 'Driver open source oficial AMD. Recomendado para RX 400+.',
             'tag': 'rec', 'type': 'free'},
            {'pkg': 'firmware-amd-graphics', 'name': 'AMD Firmware',
             'desc': 'Firmware para aceleração de hardware AMD.',
             'tag': 'rec', 'type': 'free'},
            {'pkg': 'xserver-xorg-video-radeon', 'name': 'Radeon (Legacy)',
             'desc': 'Driver para placas AMD mais antigas (pré-GCN).',
             'tag': 'ok', 'type': 'free'},
        ]

    elif vendor == 'Intel' and dtype == 'GPU':
        drivers += [
            {'pkg': 'xserver-xorg-video-intel', 'name': 'Intel Graphics',
             'desc': 'Driver open source oficial Intel.',
             'tag': 'rec', 'type': 'free'},
            {'pkg': 'intel-microcode', 'name': 'Intel Microcode',
             'desc': 'Atualizações de microcódigo do processador Intel.',
             'tag': 'rec', 'type': 'free'},
            {'pkg': 'libva-intel-driver', 'name': 'Intel VA-API Driver',
             'desc': 'Aceleração de vídeo por hardware Intel (H.264, HEVC).',
             'tag': 'rec', 'type': 'free'},
            {'pkg': 'intel-media-va-driver', 'name': 'Intel Media Driver',
             'desc': 'Driver de mídia para Intel Iris/UHD 6ª geração ou superior.',
             'tag': 'rec', 'type': 'free'},
        ]

    elif dtype == 'WiFi':
        drivers.append({
            'pkg': 'linux-firmware', 'name': 'Linux Firmware',
            'desc': 'Firmware genérico para dispositivos WiFi e Bluetooth.',
            'tag': 'rec', 'type': 'free'
        })
        if vendor == 'Broadcom':
            drivers += [
                {'pkg': 'broadcom-sta-dkms', 'name': 'Broadcom STA (wl)',
                 'desc': 'Driver proprietário Broadcom. Use se o open source não funcionar.',
                 'tag': 'ok', 'type': 'prop'},
                {'pkg': 'firmware-b43-installer', 'name': 'Broadcom B43',
                 'desc': 'Firmware para chips Broadcom BCM43xx.',
                 'tag': 'ok', 'type': 'free'},
            ]
        elif vendor == 'Realtek':
            drivers.append({
                'pkg': 'firmware-realtek', 'name': 'Realtek Firmware',
                'desc': 'Firmware para dispositivos Realtek WiFi/BT.',
                'tag': 'rec', 'type': 'free'
            })
        elif vendor == 'Atheros':
            drivers.append({
                'pkg': 'firmware-atheros', 'name': 'Atheros Firmware',
                'desc': 'Firmware para dispositivos Qualcomm/Atheros.',
                'tag': 'rec', 'type': 'free'
            })
        elif vendor == 'Intel':
            drivers.append({
                'pkg': 'firmware-iwlwifi', 'name': 'Intel WiFi Firmware',
                'desc': 'Firmware para placas WiFi Intel.',
                'tag': 'rec', 'type': 'free'
            })

    elif dtype == 'Áudio':
        drivers.append({
            'pkg': 'alsa-firmware-loaders', 'name': 'ALSA Firmware',
            'desc': 'Firmware para dispositivos de áudio ALSA.',
            'tag': 'rec', 'type': 'free'
        })
        drivers.append({
            'pkg': 'pulseaudio', 'name': 'PulseAudio',
            'desc': 'Servidor de áudio PulseAudio.',
            'tag': 'ok', 'type': 'free'
        })

    elif dtype == 'Bluetooth':
        drivers.append({
            'pkg': 'bluez', 'name': 'BlueZ',
            'desc': 'Stack oficial Bluetooth para Linux.',
            'tag': 'rec', 'type': 'free'
        })
        drivers.append({
            'pkg': 'bluetooth', 'name': 'Bluetooth Tools',
            'desc': 'Ferramentas e serviço Bluetooth.',
            'tag': 'rec', 'type': 'free'
        })

    return drivers

