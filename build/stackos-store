BACKUP_DIR = '/var/backups/stackos'
MAX_BACKUPS = 3

def run(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True)

def is_installed(pkg):
    return bool(run(f"dpkg -l {pkg} 2>/dev/null | grep '^ii'").stdout.strip())

def get_version(pkg):
    r = run(f"dpkg -l {pkg} 2>/dev/null | grep '^ii'")
    if r.stdout.strip():
        p = r.stdout.strip().split()
        return p[2] if len(p) >= 3 else None
    return None

def check_updates_silent():
    """Roda apt update em segundo plano e retorna lista de pacotes."""
    run("pkexec apt-get update -qq 2>/dev/null")
    r = run("apt list --upgradable 2>/dev/null | grep -v 'Listing...'")
    pkgs = []
    for line in r.stdout.strip().splitlines():
        if '/' in line:
            parts = line.split()
            name = parts[0].split('/')[0]
            ver  = parts[1] if len(parts) > 1 else ''
            pkgs.append((name, ver))
    return pkgs

def do_backup():
    os.makedirs(BACKUP_DIR, exist_ok=True)
    ts = datetime.datetime.now().strftime('%Y%m%d_%H%M%S')
    dest = f"{BACKUP_DIR}/{ts}"; os.makedirs(dest, exist_ok=True)
    latest = f"{BACKUP_DIR}/latest"
    link = f"--link-dest={latest}" if os.path.exists(latest) else ""
    run(f"rsync -aAX --delete {link} / {dest}/ --exclude=/proc --exclude=/sys --exclude=/dev --exclude=/tmp --exclude=/run --exclude={BACKUP_DIR}")
    if os.path.islink(latest): os.remove(latest)
    os.symlink(dest, latest)
    backups = sorted([d for d in os.listdir(BACKUP_DIR) if d != 'latest'])
    while len(backups) > MAX_BACKUPS:
        shutil.rmtree(f"{BACKUP_DIR}/{backups[0]}", ignore_errors=True); backups.pop(0)
    return ts

