    def show_backups(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        vbox.set_margin_top(16); vbox.set_margin_start(16)
        vbox.set_margin_end(16); vbox.set_margin_bottom(16)
        title = Gtk.Label(label="Backups do Sistema")
        title.add_css_class('det-name'); title.set_halign(Gtk.Align.START)
        title.set_margin_bottom(10); vbox.append(title)
        if not os.path.exists(BACKUP_DIR):
            l = Gtk.Label(label="Nenhum backup encontrado.")
            l.add_css_class('label-gray'); vbox.append(l)
            self.list_scroll.set_child(vbox); return
        backups = sorted([d for d in os.listdir(BACKUP_DIR) if d != 'latest'], reverse=True)
        if not backups:
            l = Gtk.Label(label="Nenhum backup encontrado.")
            l.add_css_class('label-gray'); vbox.append(l)
            self.list_scroll.set_child(vbox); return
        for b in backups:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            row.add_css_class('backup-item'); row.set_margin_bottom(6)
            info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            info.set_hexpand(True); info.set_margin_top(12)
            info.set_margin_bottom(12); info.set_margin_start(16)
            lbl = Gtk.Label(label=f"Backup: {b}"); lbl.add_css_class('det-pkg')
            lbl.set_halign(Gtk.Align.START); info.append(lbl)
            path = f"{BACKUP_DIR}/{b}"
            try:
                size = run(f"du -sh {path}").stdout.split()[0]
                slbl = Gtk.Label(label=f"Tamanho: {size}"); slbl.add_css_class('label-gray')
                slbl.set_halign(Gtk.Align.START); info.append(slbl)
            except: pass
            row.append(info)
            btns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            btns.set_valign(Gtk.Align.CENTER); btns.set_margin_end(12)
            rb = Gtk.Button(label="Restaurar"); rb.add_css_class('btn-install')
            rb.connect('clicked', lambda _, p=path: self.restore_backup(p)); btns.append(rb)
            db = Gtk.Button(label="Apagar"); db.add_css_class('btn-remove')
            db.connect('clicked', lambda _, p=path: self.delete_backup(p)); btns.append(db)
            row.append(btns); vbox.append(row)
        self.list_scroll.set_child(vbox)

    def restore_backup(self, path):
        self._set_status("Restaurando backup...", 'orange'); self.progress.set_visible(True)
        def do():
            GLib.idle_add(self.progress.pulse)
            run(f"rsync -aAX --delete {path}/ / --exclude=/proc --exclude=/sys --exclude=/dev --exclude=/tmp --exclude=/run --exclude={BACKUP_DIR}")
            GLib.idle_add(self._set_status, "✓ Restaurado. Reinicie o sistema.", 'green')
            GLib.idle_add(self.progress.set_visible, False)
        threading.Thread(target=do, daemon=True).start()

    def delete_backup(self, path):
        shutil.rmtree(path, ignore_errors=True)
        self._set_status("Backup apagado.", 'green'); self.show_backups()

